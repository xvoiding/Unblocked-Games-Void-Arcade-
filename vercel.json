{
  "outputDirectory": "public",
  "functions": {
    "api/go.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "netlify/functions/**"
    },
    "api/icon.js": {
      "maxDuration": 10,
      "includeFiles": "netlify/functions/**"
    },
    "api/ai.js": {
      "maxDuration": 30,
      "includeFiles": "netlify/functions/**"
    },
    "api/yt.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/go",
      "destination": "/api/go"
    },
    {
      "source": "/go/(.*)",
      "destination": "/api/go?u=$1"
    },
    {
      "source": "/icon",
      "destination": "/api/icon"
    }
  ]
}
