{
  "outputDirectory": "public",
  "functions": {
    "api/go.js": { "maxDuration": 10, "includeFiles": "netlify/functions/**" },
    "api/icon.js": { "maxDuration": 10, "includeFiles": "netlify/functions/**" },
    "api/ai.js": { "maxDuration": 30, "includeFiles": "netlify/functions/**" }
  },
  "rewrites": [
    { "source": "/go", "destination": "/api/go" },
    { "source": "/icon", "destination": "/api/icon" }
  ]
}
